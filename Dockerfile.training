FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt requirements-jobs.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-jobs.txt

COPY app ./app
COPY jobs ./jobs

ENTRYPOINT ["python", "-m", "jobs.train_colisten_embeddings"]
CMD ["--workers", "4"]

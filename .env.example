LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mandatory artist blacklist (optional). Comma-separated artist names that are
# never recommended — for everyone (they can still be searched and seeded
# directly). Case-insensitive and credit-aware ("Drake" also blocks
# "Drake, 21 Savage" and "X feat. Drake"). Leave empty to disable.
#   BLACKLIST_ARTISTS=Drake, Some Other Artist
BLACKLIST_ARTISTS=

# Rate limiting (slowapi, per client IP — issue #20). All optional.
#   RATE_LIMIT_ENABLED — set to false/0/no/off to disable limiting entirely.
#   RATE_LIMIT_DEFAULT — limit applied to every route (cheap reads).
#   RATE_LIMIT_HEAVY   — stricter limit for endpoints that fan out to Last.fm and
#                        run the embedder (search, seed, features, recs, playlists).
#   RATE_LIMIT_MAINTENANCE — limit for authenticated bulk maintenance routes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_HEAVY=20/minute
RATE_LIMIT_MAINTENANCE=2/minute

# Bulk maintenance routes are disabled when this is empty. Set a strong random
# production value and send it as X-Maintenance-Key when intentionally invoking
# /songs/reembed, /songs/repack-vocab, or either /songs/backfill-* route.
MAINTENANCE_API_KEY=

# Local development database (matches docker-compose.yml)
DATABASE_URL=

# Phase 2 rollout. Beta 2 won the independent eval; keep stage_a until cutover.
RECOMMENDATION_MODEL=stage_a
COLISTEN_BETA=2
COLISTEN_MIN_NODES=20000
COLISTEN_MIN_AVG_DEGREE=8

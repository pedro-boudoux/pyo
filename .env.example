LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mandatory artist blacklist (optional). Comma-separated artist names that are
# never recommended — for everyone (they can still be searched and seeded
# directly). Case-insensitive and credit-aware ("Drake" also blocks
# "Drake, 21 Savage" and "X feat. Drake"). Leave empty to disable.
#   BLACKLIST_ARTISTS=Drake, Some Other Artist
BLACKLIST_ARTISTS=

# Local development database (matches docker-compose.yml)
DATABASE_URL=